// project_config.h.in
//
// Generated by CMake (configure_file) from the CRASH_* cache variables in the
// top-level CMakeLists.txt. This is the single source of truth for
// project-describing constants; override any of them at configure time with
// -DCRASH_...=...

#pragma once

#include <string_view>

namespace constants {

// Support email for the "send by email" action.
inline constexpr std::string_view supportEmail = "@CRASH_SUPPORT_EMAIL@";

// Developer upload endpoint for the "send to developer" action.
inline constexpr std::string_view uploadUrl = "@CRASH_UPLOAD_URL@";

// Default display name of the protected application.
inline constexpr std::string_view productName = "@CRASH_PRODUCT_NAME@";

// Default named-pipe name, without the "\\.\pipe\" prefix (added at runtime).
inline constexpr std::string_view pipeName = "@CRASH_PIPE_NAME@";

// Multipart form field names used by the developer upload.
inline constexpr std::string_view uploadFieldProduct = "@CRASH_UPLOAD_FIELD_PRODUCT@";
inline constexpr std::string_view uploadFieldReport  = "@CRASH_UPLOAD_FIELD_REPORT@";
inline constexpr std::string_view uploadFieldDump    = "@CRASH_UPLOAD_FIELD_DUMP@";

} // namespace constants
