# syntax=docker/dockerfile:1
FROM ubuntu:26.04 AS linux-test
WORKDIR /workspace
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    g++ cmake ninja-build qt6-base-dev qt6-tools-dev qt6-tools-dev-tools \
    git ca-certificates python3
RUN git clone https://chromium.googlesource.com/linux-syscall-support /opt/lss \
    && git -C /opt/lss checkout 29164a80da4d41134950d76d55199ea33fbb9613
RUN useradd --create-home --uid 1001 tester
COPY --chown=1001:1001 . /workspace
RUN mkdir -p /workspace/3rdparty/breakpad/src/third_party/lss && cp /opt/lss/linux_syscall_support.h /workspace/3rdparty/breakpad/src/third_party/lss/
USER tester
ENV QT_QPA_PLATFORM=offscreen
CMD ["python3", "tests/linux_container.py"]

